<% content_for :page_title do %>
  <%= I18n.t('spree.redirection.redirections') %>
<% end %>

<% content_for :page_actions do %>
  <%= form_with url: admin_redirections_path,
                method: :get,
                local: true,
                class: 'd-inline-flex align-items-center gap-2' do %>

    <span><%= I18n.t('spree.redirection.active_scope') %></span>

    <div class="form-check form-switch m-0">
      <%= check_box_tag :with_archival,
                        'true',
                        params[:with_archival].present?,
                        class: 'form-check-input',
                        onchange: 'this.form.submit()' %>
    </div>
  <% end %>
<% end %>

<% content_for :page_actions do %>
  <%= link_to I18n.t('spree.redirection.new_redirection'),
              new_admin_redirection_path,
              class: 'btn btn-primary' %>
<% end %>

<table class="table table-striped">
  <thead>
  <tr>
    <th><%=  I18n.t('spree.redirection.store_url') %></th>
    <th><%= I18n.t('spree.redirection.old_url') %></th>
    <th><%=  I18n.t('spree.redirection.new_url') %></th>
    <th><%=  I18n.t('spree.redirection.http_status')%></th>
    <th><%=  I18n.t('spree.redirection.external_redirection')%></th>
    <th><%= I18n.t('spree.redirection.created_at')%></th>
    <th><%= I18n.t('spree.redirection.created_by')%></th>
    <th><%= I18n.t('spree.redirection.deleted_at')%></th>
    <th><%= I18n.t('spree.redirection.deleted_by')%></th>
<!--    <th class="text-end"><%#= I18n.t('spree.redirection.actions') %></th>-->
  </tr>
  </thead>

  <tbody>
  <% @collection.each do |redirection| %>
    <tr>
      <td><%= redirection.store_url %></td>
      <td><%= redirection.old_url %></td>
      <td><%= redirection.new_url %></td>
      <td><%= redirection.http_status %></td>
      <td>
        <%= redirection.external_redirection? ? I18n.t('spree.redirection.yess') : I18n.t('spree.redirection.nos') %>
      </td>
      <td><%= l(redirection.created_at, format: :short) %></td>
      <td><%= redirection.created_by %></td>
      <% if redirection.deleted_at %>
        <td><%= l(redirection.deleted_at, format: :short) %></td>
        <td><%= redirection.deleted_by %></td>
    <% else %>
        <td> - </td>
        <td> - </td>
        <td class="text-end">
          <%= link_to_delete redirection, no_text: true %>
        </td>
    <% end %>
    </tr>
  <% end %>
  </tbody>
</table>

<%= render 'spree/admin/shared/index_table_options', collection: @collection %>
